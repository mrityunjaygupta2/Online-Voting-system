/* ---------------- Camera helpers (shared) ---------------- */

async function startCamera(boxId, placeholderId, videoElId){
  const box = document.getElementById(boxId);
  try{
    const stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'user' } });
    box.innerHTML = '<video id="' + videoElId + '" autoplay playsinline></video>';
    const video = document.getElementById(videoElId);
    video.srcObject = stream;
    return stream;
  }catch(err){
    box.innerHTML = '<div class="placeholder">Camera access denied or unavailable.<br>Please allow camera permission and try again.</div>';
    return null;
  }
}
function captureFrame(videoElId, size){
  const video = document.getElementById(videoElId);
  const canvas = document.createElement('canvas');
  canvas.width = size; canvas.height = size;
  const ctx = canvas.getContext('2d');
  ctx.drawImage(video, 0, 0, size, size);
  return canvas;
}

