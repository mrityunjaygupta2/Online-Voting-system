function lookupVoterRecord(){
  const voterId = document.getElementById('regLookupVoterId').value.trim().toUpperCase();
  const dob = document.getElementById('regLookupDob').value;
  const resultArea = document.getElementById('lookupResultArea');
  const contactFields = document.getElementById('regContactFields');
