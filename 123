<script>

/* ============================================================
   FAKE BACKEND — everything below simulates a server + database
   using localStorage. In a real system this would all live on a
   server with a proper database and a real ML face-matching
   service; here it lives entirely in the browser.

   Two separate "tables" are used, matching two different
   real-world processes:
   - ELECTORAL_ROLL : the government's existing record (issued once,
     in person, with a photo) — this is what "already has a photo".
   - DB_VOTERS       : this website's own login accounts, which link
     to an ELECTORAL_ROLL entry after the voter proves who they are.
   ============================================================ */

const DB_ROLL   = 'securevote_electoral_roll'; // pre-existing govt-style records (with photo)
const DB_VOTERS = 'securevote_voters';         // this site's login accounts (linked to a roll entry)
const DB_VOTED_IDS = 'securevote_voted_ids';   // voter IDs who already voted (identity only)
const DB_TALLY = 'securevote_tally';           // candidate -> vote count (choices only)
const DB_LOGIN_ATTEMPTS = 'securevote_login_attempts'; // per-identifier failed attempt tracking
const SESSION_KEY = 'securevote_session';

const CANDIDATES = [
  { id: 'c1', name: 'Candidate A', party: 'Unity Party' },
  { id: 'c2', name: 'Candidate B', party: 'Progress Alliance' },
  { id: 'c3', name: 'Candidate C', party: "People's Front" }
];

let currentVoter = null;   // merged {roll fields + account fields} for the logged-in user
let lookedUpRoll = null;   // roll entry found during registration lookup
let issueStream = null;
let faceStream = null;
let pendingOtp = null;     // OTP generated for the current login attempt
let pendingOtpVoter = null;

/* ---------------- Page loader ---------------- */

window.addEventListener('load', () => {
  setTimeout(() => {
    document.getElementById('pageLoader').classList.add('hidden');
  }, 400);
});

/* ---------------- Toast notifications ---------------- */
/* Replaces most alert() popups with a nicer, non-blocking notification —
   browser alert() boxes look unprofessional and block the whole page. */

function showToast(message, type){
  type = type || 'info';
  const stack = document.getElementById('toastStack');
  const toast = document.createElement('div');
  toast.className = 'toast ' + type;
  toast.textContent = message;
  stack.appendChild(toast);
  setTimeout(() => {
    toast.classList.add('fade-out');
    setTimeout(() => toast.remove(), 300);
  }, 4200);
}

/* ---------------- Custom confirm dialog ---------------- */
/* Replaces the native confirm() popup (used for the final vote confirmation)
   with a themed modal, returned as a Promise so calling code can still
   `await` a yes/no answer. */

function showConfirm(message){
  return new Promise((resolve) => {
    const overlay = document.getElementById('confirmOverlay');
    document.getElementById('confirmMessage').textContent = message;
    overlay.classList.add('active');

    const okBtn = document.getElementById('confirmOkBtn');
    const cancelBtn = document.getElementById('confirmCancelBtn');

    function cleanup(result){
      overlay.classList.remove('active');
      okBtn.removeEventListener('click', onOk);
      cancelBtn.removeEventListener('click', onCancel);
      resolve(result);
    }
    function onOk(){ cleanup(true); }
    function onCancel(){ cleanup(false); }

    okBtn.addEventListener('click', onOk);
    cancelBtn.addEventListener('click', onCancel);
  });
}

/* ---------------- Dark mode ---------------- */

function toggleDarkMode(){
  document.body.classList.toggle('dark');
  const btn = document.getElementById('darkModeBtn');
  btn.textContent = document.body.classList.contains('dark') ? '☀ Light' : '🌙 Dark';
}

/* ---------------- Accessibility: Escape closes the top-most open modal ---------------- */

document.addEventListener('keydown', (e) => {
  if(e.key === 'Escape'){
    const openOverlays = document.querySelectorAll('.overlay.active');
    if(openOverlays.length){
      const top = openOverlays[openOverlays.length - 1];
      top.classList.remove('active');
      document.body.style.overflow = 'auto';
    }
    document.getElementById('confirmOverlay').classList.remove('active');
  }
});

/* ---------------- Escaping helper (XSS fix) ---------------- */
/* Any user-supplied text that gets placed into innerHTML must be escaped
   first, otherwise something like <script> typed into Name/Voter ID
   fields could execute in the page. Everything below that builds HTML
   from stored records now routes text through this. */
function escapeHtml(str){
  if(str === undefined || str === null) return '';
  return String(str)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

/* ---------------- Storage helpers ---------------- */


function getRoll(){ return JSON.parse(localStorage.getItem(DB_ROLL) || '[]'); }
function saveRoll(list){ localStorage.setItem(DB_ROLL, JSON.stringify(list)); }
function getVoters(){ return JSON.parse(localStorage.getItem(DB_VOTERS) || '[]'); }
function saveVoters(list){ localStorage.setItem(DB_VOTERS, JSON.stringify(list)); }
function getVotedIds(){ return JSON.parse(localStorage.getItem(DB_VOTED_IDS) || '[]'); }
function saveVotedIds(list){ localStorage.setItem(DB_VOTED_IDS, JSON.stringify(list)); }
function getTally(){ return JSON.parse(localStorage.getItem(DB_TALLY) || '{}'); }
function saveTally(tally){ localStorage.setItem(DB_TALLY, JSON.stringify(tally)); }
function getAttempts(){ return JSON.parse(localStorage.getItem(DB_LOGIN_ATTEMPTS) || '{}'); }
function saveAttempts(obj){ localStorage.setItem(DB_LOGIN_ATTEMPTS, JSON.stringify(obj)); }

// Generates a simple identicon-style placeholder photo (initials on a
// coloured circle) entirely on the client, with no external image or
// real person's likeness — used only for the pre-loaded sample records.
function generateAvatar(name, seedKey){
  let hash = 0;
  for(let i=0;i<seedKey.length;i++){ hash = seedKey.charCodeAt(i) + ((hash << 5) - hash); }
  const hue = Math.abs(hash) % 360;
  const canvas = document.createElement('canvas');
  canvas.width = 200; canvas.height = 200;
  const ctx = canvas.getContext('2d');
  ctx.fillStyle = `hsl(${hue},55%,42%)`;
  ctx.fillRect(0,0,200,200);
  ctx.fillStyle = 'rgba(255,255,255,.15)';
  ctx.beginPath(); ctx.arc(140,60,70,0,Math.PI*2); ctx.fill();
  const initials = name.split(' ').map(w=>w[0]).join('').substring(0,2).toUpperCase();
  ctx.fillStyle = 'white';
  ctx.font = 'bold 80px Poppins, sans-serif';
  ctx.textAlign = 'center';
  ctx.textBaseline = 'middle';
  ctx.fillText(initials, 100, 108);
  return canvas.toDataURL('image/png');
}

