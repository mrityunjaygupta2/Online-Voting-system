    resultArea.innerHTML = '<div class="notice bad">❌ Incorrect answer to the human-verification question below. Please try again.</div>';
    newCaptcha('reg');
    return;
  }

  if(!voterId || !dob){
    resultArea.innerHTML = '<div class="notice bad">Please enter both Voter ID and Date of Birth.</div>';
    return;
  }

  const roll = getRoll();
  const record = roll.find(v => v.voterId === voterId && v.dob === dob);

  if(!record){
    resultArea.innerHTML = '<div class="notice bad">❌ No matching record found in the electoral roll for this Voter ID and Date of Birth.</div>';
    contactFields.style.display = 'none';
    lookedUpRoll = null;
    newCaptcha('reg');
    return;
  }

  const existingAccount = getVoters().find(v => v.voterId === voterId);
  if(existingAccount){
    resultArea.innerHTML = `
      <div class="id-card">
        <img src="${record.photo}" alt="Voter photo on file">
        <div class="id-info">
          <h3>${escapeHtml(record.name)}</h3>
          <p>Voter ID: ${escapeHtml(record.voterId)}<br>
          ${escapeHtml(record.constituency)}, ${escapeHtml(record.state)}</p>
        </div>
      </div>
      <div class="notice bad">This Voter ID is already registered on the portal (linked to ${escapeHtml(existingAccount.email)}). Please <span style="text-decoration:underline;cursor:pointer;" onclick="switchModal('registerModal','loginModal')">login</span> instead.</div>
    `;
    contactFields.style.display = 'none';
    lookedUpRoll = null;
    newCaptcha('reg');
    return;
  }

  lookedUpRoll = record;
  resultArea.innerHTML = `
    <div class="id-card">
      <img src="${record.photo}" alt="Voter photo on file">
      <div class="id-info">
        <h3>${escapeHtml(record.name)}</h3>
        <p>Voter ID: ${escapeHtml(record.voterId)}<br>
        ${escapeHtml(record.constituency)}, ${escapeHtml(record.state)}</p>
