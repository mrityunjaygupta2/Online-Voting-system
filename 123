/* ---------------- Session auto-timeout ---------------- */

const SESSION_TIMEOUT_MS = 3 * 60 * 1000;   // 3 minutes inactive -> auto logout
const SESSION_WARNING_MS = 2 * 60 * 1000;   // warn at 2 minutes inactive
let inactivityTimer = null;
let warningTimer = null;

function resetInactivityTimer(){
  document.getElementById('sessionBanner').classList.remove('active');
  clearTimeout(inactivityTimer);
  clearTimeout(warningTimer);
  if(!currentVoter) return;
  warningTimer = setTimeout(() => {
    document.getElementById('sessionBanner').classList.add('active');
  }, SESSION_WARNING_MS);
  inactivityTimer = setTimeout(() => {
    forceLogout('Session expired due to inactivity. Please login again.');
  }, SESSION_TIMEOUT_MS);
}
['click','keydown','mousemove','touchstart'].forEach(evt => {
  document.addEventListener(evt, resetInactivityTimer, { passive: true });
});

function forceLogout(message){
  currentVoter = null;
  sessionStorage.removeItem(SESSION_KEY);
  document.getElementById('sessionBanner').classList.remove('active');
  document.querySelectorAll('.overlay.active').forEach(o => o.classList.remove('active'));
  document.body.style.overflow = 'auto';
  clearTimeout(inactivityTimer);
  clearTimeout(warningTimer);
  if(message) showToast(message, 'error');
}

