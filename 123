// Loads the reference (Voter ID) photo as an Image object. Previously this
// only resolved on success and had no failure path at all — if the photo
// ever failed to decode (or simply took too long), the returned Promise
// would never settle, and the whole verification flow would hang forever
// right at "Verifying against Voter ID photo…" with no error shown. It now
// rejects on error and on a timeout, so that failure case always surfaces
// as a message instead of a silent freeze.
function loadImage(src){
  return new Promise((resolve, reject) => {
    if(!src){
      reject(new Error('No reference Voter ID photo is available for this account.'));
      return;
    }
    const img = new Image();
    const timer = setTimeout(() => {
      reject(new Error('Reference photo took too long to load.'));
    }, 6000);
    img.onload = () => { clearTimeout(timer); resolve(img); };
    img.onerror = () => { clearTimeout(timer); reject(new Error('Reference photo failed to load.')); };
    img.src = src;
  });
}

// Simplified similarity check: downsamples both images to a small grayscale
// grid and compares pixel brightness. This is NOT a real biometric face
// recognition model (that would require a trained neural network such as
// FaceNet/ArcFace running on a server) — it is a lightweight stand-in so
// the verification step in this demo actually computes something real
// instead of always trivially passing.
function computeSimilarity(canvasA, imgB){
  const size = 32;
  const c1 = document.createElement('canvas'); c1.width = size; c1.height = size;
  const c2 = document.createElement('canvas'); c2.width = size; c2.height = size;
  const ctx1 = c1.getContext('2d');
  const ctx2 = c2.getContext('2d');
  ctx1.drawImage(canvasA, 0, 0, size, size);
  ctx2.drawImage(imgB, 0, 0, size, size);

  const d1 = ctx1.getImageData(0,0,size,size).data;
  const d2 = ctx2.getImageData(0,0,size,size).data;

  let diffSum = 0, count = 0;
  for(let i=0; i<d1.length; i+=4){
    const g1 = 0.3*d1[i] + 0.59*d1[i+1] + 0.11*d1[i+2];
    const g2 = 0.3*d2[i] + 0.59*d2[i+1] + 0.11*d2[i+2];
    diffSum += Math.abs(g1-g2);
    count++;
  }
  const meanDiff = diffSum / count;
  return Math.max(0, 100 - (meanDiff/255*100));
}

function wait(ms){ return new Promise(r => setTimeout(r, ms)); }

// Waits for the video element to actually have a usable frame ready
// (readyState >= 2). Capturing before this can silently grab a blank
// black frame, which was one cause of the flow appearing to "hang" at
// the end with a result that never looked right.
function waitForVideoFrame(videoEl, timeoutMs){
  return new Promise((resolve) => {
    if(videoEl.readyState >= 2) return resolve(true);
    const check = setInterval(() => {
      if(videoEl.readyState >= 2){ clearInterval(check); resolve(true); }
    }, 100);
    setTimeout(() => { clearInterval(check); resolve(videoEl.readyState >= 2); }, timeoutMs);
  });
}

// Frame-to-frame MOTION check (not identity match — that's computeSimilarity).
// Downsamples two live camera frames and measures how much brightness
// changed between them. A real head turn produces a clear, sustained
// change; a static photo held up to the camera, or someone who simply
// didn't move, produces a near-zero difference. This is what actually
// enforces "you must move your head", instead of just trusting a timer.
function computeMotion(canvasA, canvasB){
  const size = 24;
  const c1 = document.createElement('canvas'); c1.width = size; c1.height = size;
  const c2 = document.createElement('canvas'); c2.width = size; c2.height = size;
  const ctx1 = c1.getContext('2d');
  const ctx2 = c2.getContext('2d');
  ctx1.drawImage(canvasA, 0, 0, size, size);
  ctx2.drawImage(canvasB, 0, 0, size, size);
  const d1 = ctx1.getImageData(0,0,size,size).data;
  const d2 = ctx2.getImageData(0,0,size,size).data;
  let diffSum = 0, count = 0;
  for(let i=0; i<d1.length; i+=4){
    const g1 = 0.3*d1[i] + 0.59*d1[i+1] + 0.11*d1[i+2];
    const g2 = 0.3*d2[i] + 0.59*d2[i+1] + 0.11*d2[i+2];
    diffSum += Math.abs(g1-g2);
    count++;
  }
  return diffSum / count; // higher = more change between the two frames
}

// Guided sequence: look straight -> turn left -> turn right -> hold still.
// A frame is captured at EACH stage, and motion is measured between
// consecutive frames — the person must actually move for the LEFT and
// RIGHT prompts to pass, otherwise verification fails with a clear
// "no head movement detected" message instead of silently continuing.
// The whole thing runs inside try/catch/finally so any unexpected error
// (camera glitch, blank frame, etc.) always re-enables the button and
// shows a message, instead of leaving the UI stuck on "Hold still".
const MOTION_THRESHOLD = 4.5; // minimum measured change to count as real movement

// SIMPLIFIED MODE (per demo request): the earlier version required real
// head-turn motion AND a pixel-similarity match against the Voter ID photo,
// which kept failing in testing. For now this step only requires that the
// camera is on and a frame is actually captured (i.e. permission was
// granted and something is visible) — it no longer compares the live frame
// to the Voter ID photo at all. This is intentionally the "easy" version of
// this step; the fuller check (computeMotion/computeSimilarity, still
// defined above) can be re-enabled later once the matching flow is verified
// to work reliably.
async function startLivenessSequence(){
  const btn = document.getElementById('verifyFaceBtn');
  const resultArea = document.getElementById('matchResultArea');

  const watchdog = new Promise((_, reject) => {
    setTimeout(() => reject(new Error('Verification timed out — please retry.')), 15000);
  });

  try{
    await Promise.race([runLivenessSteps(btn, resultArea), watchdog]);
  }catch(err){
    console.error('Liveness sequence error:', err);
    setInstruction('⚠ Verification error — please retry');
    resultArea.innerHTML = '<div class="notice bad">⚠ ' + escapeHtml(err.message || 'Something went wrong during verification.') + ' Please click Retry.</div>';
    btn.disabled = false;
    btn.textContent = 'Retry Verification';
  }
}

async function runLivenessSteps(btn, resultArea){
    const video = document.getElementById('faceVideo');
    if(!video){
      showToast('Camera is not active. Please allow camera access.', 'error');
      return;
    }

    btn.disabled = true;
    resultArea.innerHTML = '';
    btn.textContent = 'Verifying…';

    await waitForVideoFrame(video, 3000);
    setInstruction('Detecting face…');
    await wait(1200);
    const frame = captureFrame('faceVideo', 240);

    if(!frame){
      throw new Error('Could not read a frame from the camera. Please retry.');
    }

    setInstruction('Face detected ✅');
    await wait(700);

    setInstruction('✅ Verified');
    resultArea.innerHTML = '<div class="notice good">✅ Camera access confirmed and face detected — proceeding to vote.</div>';
    stopStream(faceStream);
    setTimeout(() => {
      closeModal('faceModal');
      openBallot(currentVoter);
    }, 800);
}


/* ---------------- Voting ---------------- */

// Cross-tab / duplicate-attempt lock: while a vote for this voterId is
// mid-flight in any tab, a short-lived lock key blocks a second attempt
// (e.g. the same voter opening two tabs and clicking two candidates at once).
const VOTE_LOCK_PREFIX = 'securevote_lock_';
const VOTE_LOCK_MS = 8000;

function acquireVoteLock(voterId){
  const key = VOTE_LOCK_PREFIX + voterId;
  const existing = localStorage.getItem(key);
  if(existing && Date.now() < parseInt(existing, 10)){
    return false;
  }
  localStorage.setItem(key, String(Date.now() + VOTE_LOCK_MS));
  return true;
}
function releaseVoteLock(voterId){
  localStorage.removeItem(VOTE_LOCK_PREFIX + voterId);
}

function openBallot(voter){
  const votedIds = getVotedIds();
  const ballotArea = document.getElementById('ballotArea');
  const alreadyArea = document.getElementById('alreadyVotedArea');
  const sub = document.getElementById('votingSub');

  sub.textContent = 'Welcome, ' + voter.name + '. Select one candidate below.';

  if(votedIds.includes(voter.voterId)){
    ballotArea.style.display = 'none';
    alreadyArea.style.display = 'block';
  } else {
    ballotArea.style.display = 'block';
    alreadyArea.style.display = 'none';
    ballotArea.innerHTML = CANDIDATES.map(c => `
      <div class="card" style="margin-bottom:14px;cursor:pointer;" onclick="castVote('${c.id}','${escapeHtml(c.name)}')">
        <h3>${escapeHtml(c.name)}</h3>
        <p>${escapeHtml(c.party)}</p>
      </div>
    `).join('');
  }

  openModal('votingModal');
}

// SHA-256 based receipt: hash(voterId + candidateId + timestamp + random salt).
// The salt/timestamp mean the hash can't be reverse-engineered to figure out
// the candidate, but the voter can keep this string as proof a vote with
// this exact fingerprint was recorded (real E2E-verifiable systems use a
// more elaborate version of this same idea).
async function sha256Hex(message){
  const data = new TextEncoder().encode(message);
  const hashBuffer = await crypto.subtle.digest('SHA-256', data);
  return Array.from(new Uint8Array(hashBuffer)).map(b => b.toString(16).padStart(2,'0')).join('');
}

async function castVote(candidateId, candidateName){
  const voterId = currentVoter.voterId;
  const votedIds = getVotedIds();

  if(votedIds.includes(voterId)){
    showToast('You have already voted. Only one vote per voter is allowed.', 'error');
    return;
  }

  if(!acquireVoteLock(voterId)){
    showToast('A vote is already being processed for this account (possibly in another tab). Please wait.', 'error');
    return;
  }

  const confirmed = await showConfirm('Confirm your vote for ' + candidateName + '? This cannot be changed afterwards.');
  if(!confirmed){
    releaseVoteLock(voterId);
    return;
  }

  // Re-check after the confirm() dialog in case another tab voted meanwhile.
  const freshVotedIds = getVotedIds();
  if(freshVotedIds.includes(voterId)){
    releaseVoteLock(voterId);
    showToast('You have already voted. Only one vote per voter is allowed.', 'error');
    closeModal('votingModal');
    return;
  }

  freshVotedIds.push(voterId);
  saveVotedIds(freshVotedIds);

  const tally = getTally();
  tally[candidateId] = (tally[candidateId] || 0) + 1;
  saveTally(tally);

  const salt = crypto.getRandomValues(new Uint32Array(4)).join('-');
  const timestamp = new Date().toISOString();
  const receiptSource = voterId + '|' + candidateId + '|' + timestamp + '|' + salt;
  const hash = await sha256Hex(receiptSource);

  releaseVoteLock(voterId);
  closeModal('votingModal');

  document.getElementById('receiptBox').innerHTML =
    '<span class="receipt-label">Voter ID (for your reference only)</span>' + escapeHtml(voterId) + '<br><br>' +
    '<span class="receipt-label">Timestamp</span>' + escapeHtml(timestamp) + '<br><br>' +
    '<span class="receipt-label">Receipt Hash (SHA-256)</span>' + hash;

  renderReceiptQr(hash);

  openModal('receiptModal');
}

/* ---------------- QR code for the vote receipt ---------------- */
/* Encodes just the receipt hash (not the candidate or voter identity) so
   scanning it can only ever prove "a vote with this fingerprint exists",
   consistent with the same non-linkability promise as the text receipt. */
function renderReceiptQr(hash){
  const box = document.getElementById('receiptQrBox');
  box.innerHTML = '';
  if(typeof QRCode === 'undefined'){
    box.innerHTML = '<span style="font-size:12px;color:#888;">QR code library unavailable — text receipt above still works.</span>';
    return;
  }
  new QRCode(box, {
    text: hash,
    width: 150,
    height: 150,
    colorDark: '#0b3d91',
    colorLight: '#ffffff'
  });
}

/* ---------------- Admin / Results dashboard ---------------- */

function openAdminDashboard(){
  renderAdminDashboard();
  openModal('adminModal');
}

function renderAdminDashboard(){
  const tally = getTally();
  const area = document.getElementById('adminBarsArea');
  const emptyNotice = document.getElementById('adminEmptyNotice');

  const totalVotes = Object.values(tally).reduce((a, b) => a + b, 0);

  if(totalVotes === 0){
    area.innerHTML = '';
    emptyNotice.style.display = 'block';
    return;
  }
  emptyNotice.style.display = 'none';

  const maxVotes = Math.max(...CANDIDATES.map(c => tally[c.id] || 0), 1);

  area.innerHTML = CANDIDATES.map(c => {
    const count = tally[c.id] || 0;
    const pct = Math.round((count / maxVotes) * 100);
    return `
      <div class="admin-bar-row">
        <div class="admin-bar-label">${escapeHtml(c.name)}</div>
        <div class="admin-bar-track"><div class="admin-bar-fill" style="width:${pct}%;"></div></div>
        <div class="admin-bar-count">${count}</div>
      </div>
    `;
  }).join('') + `<p style="text-align:center;font-size:13px;color:#666;margin-top:10px;">Total votes cast: ${totalVotes}</p>`;
}

/* ---------------- CSV export ---------------- */

function downloadCsv(filename, rows){
  const csv = rows.map(row =>
    row.map(cell => '"' + String(cell === undefined || cell === null ? '' : cell).replace(/"/g, '""') + '"').join(',')
  ).join('\n');
  const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
  const url = URL.createObjectURL(blob);
  const link = document.createElement('a');
  link.href = url;
  link.download = filename;
  document.body.appendChild(link);
  link.click();
  document.body.removeChild(link);
  URL.revokeObjectURL(url);
}

function exportTallyCsv(){
  const tally = getTally();
  const rows = [['Candidate', 'Party', 'Votes']];
  CANDIDATES.forEach(c => rows.push([c.name, c.party, tally[c.id] || 0]));
  downloadCsv('vote_tally.csv', rows);
  showToast('Tally CSV downloaded.', 'success');
}

function exportVotersCsv(){
  const voters = getVoters();
  const rows = [['Voter ID', 'Name', 'State', 'Constituency', 'Email', 'Mobile']];
  voters.forEach(v => rows.push([v.voterId, v.name, v.state, v.constituency, v.email, v.mobile]));
  downloadCsv('registered_voters.csv', rows);
  showToast('Registered voters CSV downloaded.', 'success');
}

