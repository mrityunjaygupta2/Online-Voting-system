<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Secure Remote Voting System</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='18' fill='%230b3d91'/%3E%3Ctext x='50' y='68' font-size='58' text-anchor='middle'%3E%F0%9F%97%B3%EF%B8%8F%3C/text%3E%3C/svg%3E">

<link href="https://fonts.googleapis.com/css2?family=Merriweather:wght@700;900&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:'Poppins',sans-serif;
}

html{
scroll-behavior:smooth;
}

body{
color:#1b1b1b;
background:
linear-gradient(rgba(238,241,248,.95),rgba(238,241,248,.97)),
url('https://images.unsplash.com/photo-1591189863430-ab87e120f312?w=1200&q=60') center/cover fixed;
}

h1,h2,h3{
font-family:'Merriweather',serif;
}

/* ---------- Government-style top strip ---------- */

.tricolor{
height:5px;
width:100%;
background:linear-gradient(90deg,#FF9933 33%,#ffffff 33%,#ffffff 66%,#138808 66%);
}

.gov-bar{
background:#062654;
color:#dbe6ff;
font-size:12.5px;
padding:6px 8%;
display:flex;
justify-content:space-between;
align-items:center;
flex-wrap:wrap;
gap:6px;
border-bottom:1px solid rgba(255,255,255,.1);
}

.gov-bar .disclaimer{
opacity:.85;
}

.gov-bar .a11y button{
background:none;
border:1px solid rgba(255,255,255,.35);
color:#dbe6ff;
padding:2px 8px;
border-radius:4px;
cursor:pointer;
font-size:12px;
margin-left:4px;
}

header{
background:#0b3d91;
color:white;
display:flex;
justify-content:space-between;
align-items:center;
padding:16px 8%;
position:sticky;
top:0;
z-index:100;
border-bottom:3px solid #ff9933;
}

.logo{
font-size:24px;
font-weight:bold;
display:flex;
align-items:center;
gap:10px;
font-family:'Merriweather',serif;
}

.emblem{
width:34px;
height:34px;
border-radius:50%;
background:radial-gradient(circle at 35% 30%,#ffdca8,#ff9933 60%,#0b3d91 100%);
display:flex;
align-items:center;
justify-content:center;
font-size:18px;
box-shadow:0 0 0 2px rgba(255,255,255,.6) inset;
}

nav a{
color:white;
text-decoration:none;
margin-left:25px;
font-weight:500;
cursor:pointer;
padding-bottom:4px;
border-bottom:2px solid transparent;
transition:.25s;
}

nav a:hover{
border-bottom:2px solid #ff9933;
}

.hero{
display:flex;
justify-content:space-between;
align-items:center;
padding:80px 8%;
background:
radial-gradient(circle at 85% 20%, rgba(255,153,51,.28), transparent 45%),
radial-gradient(circle at 10% 80%, rgba(19,136,8,.22), transparent 40%),
linear-gradient(135deg,#0b1f4d,#0b3d91 55%,#164ea8);
background-size:160% 160%,160% 160%,100% 100%;
animation:heroDrift 18s ease-in-out infinite;
color:white;
flex-wrap:wrap;
position:relative;
overflow:hidden;
}

@keyframes heroDrift{
0%{background-position:0% 0%,100% 100%,0 0;}
50%{background-position:30% 20%,70% 80%,0 0;}
100%{background-position:0% 0%,100% 100%,0 0;}
}

.floaters{
position:absolute;
inset:0;
pointer-events:none;
z-index:1;
}

.floaters span{
position:absolute;
bottom:-10%;
font-size:22px;
opacity:.16;
animation:floatUp 14s linear infinite;
}

@keyframes floatUp{
from{ transform:translateY(0) rotate(0deg); opacity:0; }
10%{ opacity:.18; }
90%{ opacity:.18; }
to{ transform:translateY(-620px) rotate(25deg); opacity:0; }
}

/* ---------- Hero: voting/security themed motion layer ---------- */

.hero-grid{
position:absolute;
inset:0;
z-index:0;
background-image:
linear-gradient(rgba(255,255,255,.05) 1px, transparent 1px),
linear-gradient(90deg, rgba(255,255,255,.05) 1px, transparent 1px);
background-size:42px 42px;
animation:heroGridDrift 22s linear infinite;
}

@keyframes heroGridDrift{
from{ background-position:0 0; }
to{ background-position:42px 42px; }
}

.hero-radar{
position:absolute;
top:50%;
right:6%;
width:520px;
height:520px;
transform:translateY(-50%);
z-index:0;
pointer-events:none;
}

.hero-radar span{
position:absolute;
top:50%;
left:50%;
width:40px;
height:40px;
margin:-20px 0 0 -20px;
border:1.5px solid rgba(255,153,51,.55);
border-radius:50%;
animation:radarPulse 4.5s ease-out infinite;
}

.hero-radar span:nth-child(2){ animation-delay:1.5s; border-color:rgba(19,136,8,.5); }
.hero-radar span:nth-child(3){ animation-delay:3s; border-color:rgba(255,255,255,.4); }

@keyframes radarPulse{
0%{ width:40px; height:40px; margin:-20px 0 0 -20px; opacity:.85; }
100%{ width:480px; height:480px; margin:-240px 0 0 -240px; opacity:0; }
}

.hero-scanline{
position:absolute;
left:0;
right:0;
height:2px;
background:linear-gradient(90deg, transparent, rgba(255,153,51,.9), rgba(19,136,8,.7), transparent);
box-shadow:0 0 12px 2px rgba(255,153,51,.5);
z-index:1;
animation:scanSweep 6s ease-in-out infinite;
}

@keyframes scanSweep{
0%{ top:6%; opacity:0; }
8%{ opacity:.8; }
50%{ top:92%; opacity:.8; }
58%{ opacity:0; }
100%{ top:92%; opacity:0; }
}

.hero-text{
max-width:600px;
position:relative;
z-index:2;
}

.hero .eyebrow{
display:inline-block;
background:rgba(255,255,255,.12);
border:1px solid rgba(255,255,255,.3);
padding:5px 14px;
border-radius:20px;
font-size:12.5px;
letter-spacing:.5px;
margin-bottom:18px;
}

.hero h1{
font-size:44px;
margin-bottom:20px;
line-height:1.25;
}

.hero p{
line-height:1.8;
margin-bottom:30px;
font-size:15.5px;
opacity:.95;
}

.btn{
padding:14px 30px;
border:none;
border-radius:8px;
cursor:pointer;
font-size:16px;
margin-right:15px;
font-weight:600;
}

.primary{
background:#ff9933;
color:white;
}

.secondary{
background:white;
color:#0b3d91;
}

.hero img{
width:430px;
max-width:100%;
border-radius:10px;
box-shadow:0 15px 40px rgba(0,0,0,.35);
position:relative;
z-index:2;
border:3px solid rgba(255,255,255,.5);
}

.section{
padding:70px 8%;
position:relative;
overflow:hidden;
}

.title{
text-align:center;
font-size:32px;
margin-bottom:50px;
position:relative;
z-index:2;
}

.cards{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
gap:25px;
position:relative;
z-index:2;
}

.card{
background:white;
padding:30px;
border-radius:12px;
box-shadow:0 5px 20px rgba(0,0,0,.08);
transition:.3s;
border-top:3px solid #0b3d91;
}

.card:hover{
transform:translateY(-8px);
}

.card h3{
margin-bottom:15px;
color:#0b3d91;
font-size:18px;
}

.steps{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
gap:25px;
position:relative;
z-index:2;
}

.step{
background:#ffffff;
padding:25px;
border-left:6px solid #0b3d91;
border-radius:8px;
box-shadow:0 5px 15px rgba(0,0,0,.08);
}

.stats{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(180px,1fr));
gap:20px;
position:relative;
z-index:2;
}

.stat{
background:#0b3d91;
color:white;
padding:30px;
border-radius:12px;
text-align:center;
}

.stat h1{
font-family:'Poppins',sans-serif;
font-weight:700;
}

footer{
background:#062654;
color:#cdd8ef;
padding:35px 8%;
text-align:center;
}

footer h2{
color:white;
font-size:20px;
margin-bottom:8px;
}

footer .disclaimer-footer{
max-width:640px;
margin:14px auto 0;
font-size:12.5px;
opacity:.8;
line-height:1.6;
border-top:1px solid rgba(255,255,255,.15);
padding-top:14px;
}

footer .ministry-credit{
max-width:640px;
margin:16px auto 0;
font-size:12px;
opacity:.65;
line-height:1.7;
}

/* ---------- Ticker banner ---------- */

.ticker-wrap{
background:#ff9933;
color:#062654;
overflow:hidden;
white-space:nowrap;
padding:6px 0;
font-size:12.5px;
font-weight:600;
border-bottom:1px solid rgba(0,0,0,.08);
}

.ticker-track{
display:inline-block;
padding-left:100%;
animation:tickerScroll 28s linear infinite;
}

@keyframes tickerScroll{
0%{ transform:translateX(0); }
100%{ transform:translateX(-100%); }
}

/* ---------- Section background motifs ---------- */

.section-bg{
position:absolute;
inset:0;
z-index:0;
pointer-events:none;
overflow:hidden;
}

.section-bg .grid-dots{
position:absolute;
inset:-20px;
background-image:radial-gradient(rgba(11,61,145,.20) 1.5px, transparent 1.5px);
background-size:26px 26px;
animation:dotsDrift 40s linear infinite;
}

@keyframes dotsDrift{
from{ background-position:0 0; }
to{ background-position:260px 260px; }
}

.section-bg .bg-icon{
position:absolute;
font-size:34px;
opacity:.13;
color:#0b3d91;
animation:iconFloat 16s ease-in-out infinite;
}

@keyframes iconFloat{
0%,100%{ transform:translateY(0) rotate(0deg); }
50%{ transform:translateY(-24px) rotate(8deg); }
}

/* ---------- Govt watermark: rotating Ashoka-Chakra-style wheel ---------- */

.section-bg .chakra{
position:absolute;
width:380px;
height:380px;
opacity:.11;
animation:chakraSpin 60s linear infinite;
}

@keyframes chakraSpin{
from{ transform:rotate(0deg); }
to{ transform:rotate(360deg); }
}

/* ---------- Govt watermark: EVM (voting machine) line-art ---------- */

.section-bg .evm-icon{
position:absolute;
width:220px;
height:auto;
opacity:.12;
animation:iconFloat 18s ease-in-out infinite;
}

/* ---------- Govt watermark: live vote-count bars ---------- */

.section-bg .vote-bars{
position:absolute;
bottom:6%;
display:flex;
align-items:flex-end;
gap:10px;
opacity:.15;
}

.section-bg .vote-bars .bar{
width:16px;
border-radius:3px 3px 0 0;
background:#0b3d91;
animation:barPulse 3.6s ease-in-out infinite;
}

@keyframes barPulse{
0%,100%{ transform:scaleY(1); }
50%{ transform:scaleY(1.6); }
}

/* ---------- Scroll reveal ---------- */

.reveal{
opacity:0;
transform:translateY(28px);
transition:opacity .7s ease, transform .7s ease;
}

.reveal.in-view{
opacity:1;
transform:translateY(0);
}

/* ---------- Modal styles ---------- */

.overlay{
display:none;
position:fixed;
top:0;
left:0;
width:100%;
height:100%;
background:rgba(6,38,84,.65);
z-index:1000;
align-items:center;
justify-content:center;
padding:20px;
}

.overlay.active{
display:flex;
}

.modal{
background:white;
width:100%;
max-width:460px;
border-radius:14px;
padding:35px;
position:relative;
max-height:90vh;
overflow-y:auto;
box-shadow:0 20px 60px rgba(0,0,0,.3);
animation:pop .25s ease;
border-top:4px solid #ff9933;
}

@keyframes pop{
from{transform:scale(.92);opacity:0;}
to{transform:scale(1);opacity:1;}
}

.modal h2{
color:#0b3d91;
margin-bottom:6px;
font-size:22px;
}

.modal .sub{
color:#666;
font-size:14px;
margin-bottom:20px;
font-family:'Poppins',sans-serif;
}

.close-btn{
position:absolute;
top:18px;
right:22px;
background:none;
border:none;
font-size:22px;
cursor:pointer;
color:#888;
}

.form-group{
margin-bottom:16px;
}

.form-group label{
display:block;
font-size:14px;
font-weight:600;
margin-bottom:6px;
color:#0b3d91;
}

.form-group input,
.form-group select{
width:100%;
padding:11px 14px;
border:1px solid #d7deef;
border-radius:8px;
font-size:15px;
font-family:'Poppins',sans-serif;
background:#f8faff;
}

.form-group input:focus,
.form-group select:focus{
outline:2px solid #2b6fff;
background:white;
}

.form-row{
display:flex;
gap:12px;
}

.form-row .form-group{
flex:1;
}

.captcha-row{
display:flex;
align-items:center;
gap:10px;
background:#f8faff;
border:1px dashed #b9c6e6;
border-radius:8px;
padding:10px 12px;
margin-bottom:16px;
}

.captcha-question{
font-weight:700;
color:#0b3d91;
font-size:15px;
white-space:nowrap;
}

.captcha-row input{
flex:1;
padding:9px 12px;
border:1px solid #d7deef;
border-radius:6px;
font-size:14px;
}

.captcha-refresh{
background:none;
border:1px solid #d7deef;
border-radius:6px;
padding:6px 9px;
cursor:pointer;
color:#0b3d91;
font-size:14px;
}

.submit-btn{
width:100%;
padding:13px;
background:#0b3d91;
color:white;
border:none;
border-radius:8px;
font-size:16px;
font-weight:600;
cursor:pointer;
margin-top:6px;
}

.submit-btn:hover{
background:#092e6e;
}

.submit-btn:disabled{
background:#a7b6d6;
cursor:not-allowed;
}

.link-btn{
width:100%;
padding:11px;
background:#eef1f8;
color:#0b3d91;
border:1px solid #d7deef;
border-radius:8px;
font-size:14px;
font-weight:600;
cursor:pointer;
margin-bottom:16px;
}

.switch-link{
text-align:center;
margin-top:16px;
font-size:14px;
color:#555;
}

.switch-link span{
color:#2b6fff;
font-weight:600;
cursor:pointer;
}

.notice{
background:#fff4e6;
border:1px solid #ffd8a8;
color:#8a5a00;
font-size:13px;
padding:10px 12px;
border-radius:8px;
margin-bottom:18px;
line-height:1.5;
}

.notice.good{
background:#eafaf0;
border-color:#b7ebc9;
color:#0d6b34;
}

.notice.bad{
background:#fdeaea;
border-color:#f3b7b7;
color:#a11d1d;
}

/* ---------- Camera / photo capture ---------- */

.camera-box{
background:#0b1f4d;
border-radius:10px;
overflow:hidden;
position:relative;
margin-bottom:12px;
aspect-ratio:4/3;
display:flex;
align-items:center;
justify-content:center;
}

.camera-box video,
.camera-box canvas,
.camera-box img{
width:100%;
height:100%;
object-fit:cover;
display:block;
}

.camera-box .frame-guide{
position:absolute;
top:12%;
left:22%;
width:56%;
height:76%;
border:2px dashed rgba(255,255,255,.6);
border-radius:50% / 40%;
pointer-events:none;
}

.camera-box .instruction-bar{
position:absolute;
bottom:0;
left:0;
right:0;
background:rgba(6,38,84,.75);
color:white;
font-size:13px;
font-weight:600;
text-align:center;
padding:8px 10px;
letter-spacing:.3px;
}

.camera-box .placeholder{
color:#9fb3e0;
font-size:14px;
text-align:center;
padding:20px;
}

.camera-actions{
display:flex;
gap:10px;
margin-bottom:16px;
}

.camera-actions button{
flex:1;
padding:11px;
border:none;
border-radius:8px;
font-size:14px;
font-weight:600;
cursor:pointer;
}

.cam-btn-primary{
background:#0b3d91;
color:white;
}

.cam-btn-secondary{
background:#eef1f8;
color:#0b3d91;
border:1px solid #d7deef !important;
}

/* ---------- Voter ID card ---------- */

.id-card{
border:1px solid #d7deef;
border-radius:12px;
padding:18px;
display:flex;
gap:16px;
align-items:center;
background:linear-gradient(135deg,#f8faff,#eef3ff);
margin-bottom:18px;
}

.id-card img{
width:80px;
height:80px;
border-radius:8px;
object-fit:cover;
border:2px solid #0b3d91;
background:#dfe6f7;
}

.id-card .id-info h3{
font-size:16px;
color:#0b3d91;
margin-bottom:4px;
font-family:'Poppins',sans-serif;
}

.id-card .id-info p{
font-size:12.5px;
color:#555;
line-height:1.5;
}

.match-score{
text-align:center;
font-size:14px;
font-weight:600;
margin-bottom:14px;
color:#0b3d91;
}

/* ---------- Vote receipt ---------- */

.receipt-box{
background:#0b1f4d;
color:#dbe6ff;
border-radius:10px;
padding:16px;
font-family:monospace;
font-size:12.5px;
word-break:break-all;
line-height:1.7;
margin-bottom:14px;
border:1px dashed rgba(255,255,255,.25);
}

.receipt-box .receipt-label{
color:#9fb3e0;
font-family:'Poppins',sans-serif;
font-size:11.5px;
text-transform:uppercase;
letter-spacing:.5px;
display:block;
margin-bottom:4px;
}

/* ---------- Session timeout banner ---------- */

.session-banner{
position:fixed;
top:0;
left:0;
right:0;
background:#a11d1d;
color:white;
text-align:center;
font-size:13px;
font-weight:600;
padding:8px;
z-index:2000;
display:none;
}

.session-banner.active{
display:block;
}

@media(max-width:768px){

.hero{
flex-direction:column;
text-align:center;
}

.hero h1{
font-size:32px;
}

nav{
display:none;
}

.gov-bar{
font-size:11px;
}

.captcha-row{
flex-wrap:wrap;
}

}

/* ---------- Page loader ---------- */

.page-loader{
position:fixed;
inset:0;
background:#0b1f4d;
z-index:5000;
display:flex;
flex-direction:column;
align-items:center;
justify-content:center;
gap:14px;
transition:opacity .4s ease, visibility .4s ease;
}

.page-loader.hidden{
opacity:0;
visibility:hidden;
pointer-events:none;
}

.page-loader .spinner{
width:46px;
height:46px;
border:4px solid rgba(255,255,255,.2);
border-top-color:#ff9933;
border-radius:50%;
animation:spin .8s linear infinite;
}

@keyframes spin{
to{ transform:rotate(360deg); }
}

.page-loader p{
color:#dbe6ff;
font-size:13px;
letter-spacing:.5px;
}

/* ---------- Toast notifications ---------- */

.toast-stack{
position:fixed;
top:70px;
right:20px;
z-index:6000;
display:flex;
flex-direction:column;
gap:10px;
max-width:340px;
}

.toast{
background:white;
border-left:5px solid #0b3d91;
border-radius:8px;
padding:13px 16px;
box-shadow:0 10px 30px rgba(0,0,0,.18);
font-size:13.5px;
color:#1b1b1b;
line-height:1.5;
animation:toastIn .3s ease;
}

.toast.success{ border-left-color:#0d6b34; }
.toast.error{ border-left-color:#a11d1d; }
.toast.info{ border-left-color:#2b6fff; }

@keyframes toastIn{
from{ transform:translateX(30px); opacity:0; }
to{ transform:translateX(0); opacity:1; }
}

.toast.fade-out{
animation:toastOut .3s ease forwards;
}

@keyframes toastOut{
to{ transform:translateX(30px); opacity:0; }
}

/* ---------- Custom confirm dialog ---------- */

.confirm-overlay{
display:none;
position:fixed;
inset:0;
background:rgba(6,38,84,.65);
z-index:5500;
align-items:center;
justify-content:center;
padding:20px;
}

.confirm-overlay.active{ display:flex; }

.confirm-box{
background:white;
max-width:380px;
width:100%;
border-radius:14px;
padding:26px;
text-align:center;
box-shadow:0 20px 60px rgba(0,0,0,.3);
border-top:4px solid #ff9933;
}

.confirm-box p{
font-size:15px;
margin-bottom:20px;
color:#1b1b1b;
line-height:1.6;
}

.confirm-actions{
display:flex;
gap:10px;
}

.confirm-actions button{
flex:1;
padding:11px;
border:none;
border-radius:8px;
font-size:14px;
font-weight:600;
cursor:pointer;
}

.confirm-cancel{
background:#eef1f8;
color:#0b3d91;
}

.confirm-ok{
background:#0b3d91;
color:white;
}

/* ---------- OTP screen ---------- */

.otp-boxes{
display:flex;
gap:10px;
justify-content:center;
margin-bottom:16px;
}

.otp-boxes input{
width:44px;
height:52px;
text-align:center;
font-size:22px;
font-weight:700;
border:1px solid #d7deef;
border-radius:8px;
background:#f8faff;
}

.otp-boxes input:focus{
outline:2px solid #2b6fff;
background:white;
}

.otp-demo-hint{
text-align:center;
font-size:12.5px;
color:#8a5a00;
