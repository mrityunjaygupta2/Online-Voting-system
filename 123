/* ---------------- Login (with lockout + captcha) ---------------- */

const MAX_LOGIN_ATTEMPTS = 5;
const LOCKOUT_MS = 2 * 60 * 1000; // 2 minutes

function getAttemptRecord(identifier){
  const attempts = getAttempts();
  return attempts[identifier] || { count: 0, lockedUntil: 0 };
}

function checkLockout(identifier){
  const rec = getAttemptRecord(identifier);
  const notice = document.getElementById('lockoutNotice');
  const btn = document.getElementById('loginSubmitBtn');
  if(rec.lockedUntil && Date.now() < rec.lockedUntil){
    const secsLeft = Math.ceil((rec.lockedUntil - Date.now()) / 1000);
    notice.style.display = 'block';
    notice.className = 'notice bad';
    notice.textContent = '🔒 Too many failed attempts. Locked for ' + secsLeft + ' more second(s).';
    btn.disabled = true;
    return true;
  }
  notice.style.display = 'none';
  btn.disabled = false;
  return false;
}

function recordFailedAttempt(identifier){
  const attempts = getAttempts();
  const rec = attempts[identifier] || { count: 0, lockedUntil: 0 };
  rec.count += 1;
  if(rec.count >= MAX_LOGIN_ATTEMPTS){
    rec.lockedUntil = Date.now() + LOCKOUT_MS;
    rec.count = 0;
  }
  attempts[identifier] = rec;
  saveAttempts(attempts);
}

function clearAttempts(identifier){
  const attempts = getAttempts();
  delete attempts[identifier];
  saveAttempts(attempts);
}

function handleLogin(e){
  e.preventDefault();

  const identifier = document.getElementById('loginIdentifier').value.trim();
  const password = document.getElementById('loginPassword').value;
  const captchaInput = document.getElementById('loginCaptchaAnswer').value.trim();
  const key = identifier.toLowerCase();

  if(checkLockout(key)){
    return false;
  }

  if(parseInt(captchaInput, 10) !== captchaAnswers.login){
    showToast('Incorrect answer to the human-verification question. Please try again.', 'error');
    newCaptcha('login');
    return false;
  }

  const voters = getVoters();
  const match = voters.find(v =>
    (v.voterId === identifier.toUpperCase() || v.email === identifier.toLowerCase())
    && v.password === password
  );

  if(!match){
    recordFailedAttempt(key);
    newCaptcha('login');
    checkLockout(key);
    showToast('Login failed. Check your Voter ID/Email and password, or register first.', 'error');
    return false;
  }

  clearAttempts(key);

  // Self-heal: some accounts in this browser's demo data can end up missing
  // the linked Voter ID photo (e.g. leftover data from earlier testing).
  // Re-attach it from the electoral roll record so Face Verification always
  // has a real photo to compare against, instead of failing with "no
  // reference photo found".
  if(!match.photo){
    const rollRec = getRoll().find(v => v.voterId === match.voterId);
    if(rollRec && rollRec.photo){
      match.photo = rollRec.photo;
      const voters = getVoters();
      const idx = voters.findIndex(v => v.voterId === match.voterId);
      if(idx > -1){
        voters[idx].photo = rollRec.photo;
        saveVoters(voters);
      }
    }
  }

  currentVoter = match;
  sessionStorage.setItem(SESSION_KEY, match.voterId);
  document.getElementById('loginForm').reset();
  document.getElementById('lockoutNotice').style.display = 'none';
  closeModal('loginModal');
  resetInactivityTimer();

  startOtpStep(match);
  return false;
}

/* ---------------- OTP verification step (simulated) ---------------- */
/* No real SMS/email is sent (this is a client-only demo). A random 4-digit
   OTP is generated and shown in a "demo hint" banner so the flow can be
   completed without a real messaging backend, but the actual input +
   validation logic works exactly like a real OTP screen would. */

function generateOtp(){
  return String(Math.floor(1000 + Math.random() * 9000));
}

function startOtpStep(voter){
  pendingOtpVoter = voter;
  pendingOtp = generateOtp();

  const maskedMobile = voter.mobile ? ('••••••' + voter.mobile.slice(-4)) : 'your registered mobile';
  document.getElementById('otpSub').textContent = 'Enter the 4-digit OTP sent to ' + maskedMobile + '.';
  document.getElementById('otpDemoHint').textContent = '🔑 Demo mode — no real SMS is sent. Your OTP is: ' + pendingOtp;
  document.getElementById('otpErrorNotice').style.display = 'none';

  const digits = document.querySelectorAll('.otp-digit');
  digits.forEach(d => d.value = '');

  openModal('otpModal');
  setupOtpInputs();
  if(digits[0]) digits[0].focus();
}

function setupOtpInputs(){
  const digits = document.querySelectorAll('.otp-digit');
  digits.forEach((input, i) => {
    input.oninput = () => {
      input.value = input.value.replace(/[^0-9]/g, '').slice(0, 1);
      if(input.value && digits[i + 1]) digits[i + 1].focus();
    };
    input.onkeydown = (e) => {
      if(e.key === 'Backspace' && !input.value && digits[i - 1]) digits[i - 1].focus();
      if(e.key === 'Enter') verifyOtp();
    };
  });
}

function resendOtp(){
  if(!pendingOtpVoter) return;
  pendingOtp = generateOtp();
  document.getElementById('otpDemoHint').textContent = '🔑 Demo mode — no real SMS is sent. Your new OTP is: ' + pendingOtp;
  showToast('A new OTP has been generated (demo mode).', 'info');
}

function verifyOtp(){
  const digits = document.querySelectorAll('.otp-digit');
  const entered = Array.from(digits).map(d => d.value).join('');

  if(entered.length < 4){
    document.getElementById('otpErrorNotice').style.display = 'block';
    document.getElementById('otpErrorNotice').textContent = '❌ Please enter all 4 digits.';
    return;
  }

  if(entered !== pendingOtp){
    document.getElementById('otpErrorNotice').style.display = 'block';
    document.getElementById('otpErrorNotice').textContent = '❌ Incorrect OTP. Please try again.';
    digits.forEach(d => d.value = '');
    if(digits[0]) digits[0].focus();
    return;
  }

  document.getElementById('otpErrorNotice').style.display = 'none';
  closeModal('otpModal');
  showToast('OTP verified successfully.', 'success');
  showIdCard(pendingOtpVoter);
  pendingOtp = null;
}

